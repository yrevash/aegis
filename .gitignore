# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Env / secrets
.env
.env.*
!.env.example

# Node / web console (Next.js)
node_modules/
dist/
.next/
*.tsbuildinfo
*.local

# Data / models / artifacts (regenerated locally)
*.db
*.sqlite
data/*.parquet
data/*.csv
*.joblib
*.pkl

# Local infra state
phoenix.db
neo4j/
redis-data/

# Garak red-team reports + transient generator configs (regenerated on the day)
backend/scripts/garak_reports/

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/

# Linked worktrees (carry venv/node_modules) — never scan or track
.claude/

# superpowers scratch (sdd reports, brainstorm mockups)
.superpowers/
.frontend-templates/

# Generated teaching site (regenerate with scripts/build-teaching-html.mjs).
# The Markdown is the source of truth; the HTML is a disposable view, and the
# vendored mermaid bundle is 3.4 MB of third-party code that does not belong in
# this repo's history.
docs/teaching/**/*.html
docs/teaching/_assets/
