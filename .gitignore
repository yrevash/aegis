# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Env / secrets
.env
.env.*
!.env.example

# Node / web console (Next.js)
node_modules/
dist/
.next/
*.tsbuildinfo
*.local

# Data / models / artifacts (regenerated locally)
*.db
*.sqlite
data/*.parquet
data/*.csv
*.joblib
*.pkl

# Docling parse cache for scripts/eval_goldset.py (re-derivable, ~30 MB)
.parse-cache/

# Local infra state
phoenix.db
neo4j/
redis-data/

# Garak red-team reports + transient generator configs (regenerated on the day)
backend/scripts/garak_reports/

# OS
.DS_Store
Thumbs.db

# Local service runtime artifacts. These were committed by accident once: a Postgres
# startup log and an 88-byte Redis snapshot, neither of which says anything about this
# codebase. They reappear whenever someone runs the stack locally.
.pglog
*.rdb
dump.rdb

# Editor
.vscode/
.idea/

# Linked worktrees (carry venv/node_modules) — never scan or track
.claude/

# superpowers scratch (sdd reports, brainstorm mockups)
.superpowers/
.frontend-templates/

# Generated API reference (regenerate with scripts/build_api_docs.py). Derived
# entirely from the docstrings in aegis/src, so committing it would add a second
# copy that goes stale the moment a signature changes and buries every real diff
# in review noise. aegis/PUBLIC.md is the hand-written part, and it IS committed.
docs/api/

# Generated teaching site (regenerate with scripts/build-teaching-html.mjs).
# The Markdown is the source of truth; the HTML is a disposable view, and the
# vendored mermaid bundle is 3.4 MB of third-party code that does not belong in
# this repo's history.
docs/teaching/**/*.html
docs/teaching/_assets/

# Phase 4 ingestion fixtures: downloaded by tests/fixtures/pdfs/fetch.sh, not committed
# (two are arXiv papers whose licence does not clearly permit redistribution — see the README)
tests/fixtures/pdfs/*.pdf

# Uploaded document bytes and the parse artifacts beside them. NOT tracked and NOT
# disposable: the `documents` rows in Postgres survive a `git clean -fd` while these
# do not, and a document whose bytes are gone cannot be re-ingested through the API
# (the upload dedupes on content_sha256). Audit C lost this tree twice mid-parse.
backend/document_storage/
document_storage/
backend/vector_storage/
vector_storage/

# Superset instance (venv + metadata DB). Lives in the project so it survives a
# reboot; too large and too machine-specific for git. Rebuild: scripts/superset.sh
.superset/

# Lane screenshot scratch
.console-shots/

# LightRAG runtime cache — regenerated on every ingest, never source.
backend/rag_storage/

# Audit evidence — screenshots, probe scripts and raw captures from the platform
# audits. Deliberately NOT committed: ~81MB of PNGs that git would keep forever, and
# the captures carry live bearer tokens and the Postgres DSN. The findings live in the
# commit messages; the evidence is reproducible by re-running the audit.
testdata/audit/
