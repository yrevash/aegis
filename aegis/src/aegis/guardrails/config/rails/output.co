# Output rail — runs before any text reaches the user / downstream.
# Layer order mirrors aegis/guardrails/pipeline.py: schema + content-filter -> PII.
# Colang 1.0. Each `execute` call resolves to a custom action in ../actions.py.

define bot refuse output
  "The response was withheld by the output guardrail."

# Advisory note for the grounding rail (no `stop`; the answer is still delivered).
define bot inform ungrounded
  "Note: this answer may not be fully grounded in the retrieved sources."

# 1. Output schema validation + content filter. Guards against insecure output
#    handling (LLM02) and obvious system-prompt leakage before anything is used
#    downstream.
define flow guardrail output schema
  $valid = execute validate_output_schema
  if not $valid
    bot refuse output
    stop

# 2. Content-safety screen over the MLCommons / Llama Guard hazard taxonomy
#    (S1–S13), mirroring the programmatic pipeline's outbound content-safety layer
#    (LLM09 harmful output). Fails closed on an ambiguous verdict.
define flow guardrail output content safety
  $safe = execute self_check_content_safety
  if not $safe
    bot refuse output
    stop

# 3. Output grounding / hallucination self-check (OWASP LLM09 Misinformation).
#    The check RUNS and is recorded in the rail log; it deliberately emits nothing.
#
#    It used to end `bot inform ungrounded`, commented "no `stop`; the answer is
#    still delivered". That comment was wrong about NeMo's own semantics: a `bot`
#    message inside an OUTPUT rail *replaces* the answer and NeMo records the rail
#    as having stopped the turn, which `_stopped_rails` reads — correctly — as a
#    block. So the flow documented as advisory withheld the answer outright, and a
#    legitimate "I don't have that document" refusal reached the user as
#    "[response withheld by the output guardrail]". Worse than the hallucination it
#    was meant to catch.
#
#    An output rail cannot annotate; it can only replace. So the annotation belongs
#    to the programmatic pipeline, which raises the same finding as a non-blocking
#    FLAG (`Guardrails._screen_grounding`), and both engines run on every turn.
#    An enterprise wanting a hard block adds `bot refuse output` + `stop` here,
#    which is then a deliberate withholding rather than an accidental one.
define flow guardrail output grounding
  $grounded = execute self_check_grounding

# 4. PII redaction on the outbound path (sensitive information disclosure, LLM06).
#    The action rewrites the bot message with any PII masked.
define flow guardrail output pii
  $bot_message = execute redact_pii_output

# ── Media on the outbound path ───────────────────────────────────────────────
# A model that RETURNS an image is a channel too: a generated image carrying
# rendered text is the same exfiltration surface pointed the other way. Same two
# controls as the inbound path, same fail-closed posture, no-op on text turns.
define flow guardrail output media hygiene
  $clean = execute check_media_hygiene
  if not $clean
    bot refuse output
    stop

define flow guardrail output media injection
  $safe = execute self_check_media_injection
  if not $safe
    bot refuse output
    stop
