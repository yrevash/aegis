# Aegis Console — frontend environment
# Live-first: copy to `.env.local` and it streams from the live backend as-is.

# Base URL of the FastAPI backend (no trailing slash). Required in live mode.
VITE_API_BASE=http://localhost:8000

# Use the in-browser mock transport instead of a live backend.
# Live-first: this is `false` by default so the console streams from the real
# backend above. Set to `true` only as a fallback to demo without a backend.
VITE_USE_MOCK=false
