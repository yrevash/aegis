# ── Model gateway (LiteLLM → custom OpenAI-compatible provider) ──────────────
GENAILAB_BASE_URL=https://genailab.tcs.in
GENAILAB_API_KEY=replace-me
# Gateway uses a self-signed cert; disable TLS verification for it only.
GENAILAB_SSL_VERIFY=false

# ── Local stores (no Docker; local installs) ─────────────────────────────────
# TWO Postgres DSNs, and the difference between them is a security boundary.
#
# POSTGRES_DSN is the SERVING connection: every request runs on it. It must name a role
# with neither SUPERUSER nor BYPASSRLS, because Postgres skips row security entirely for
# a role that has either — which makes all 13 tenant_isolation policies inert. Run
# `scripts/db-roles.sh` (or `scripts\db-roles.ps1`) once: it creates `aegis_app` with
# only the DML grants it needs and rewrites these two lines for you.
#
# POSTGRES_ADMIN_DSN is the OWNER/DDL connection: create_all, the additive schema
# reconciler and the RLS bootstrap run there, and nothing else does. Those steps
# legitimately bypass RLS; keeping them on their own connection is what makes bypass a
# property of the connection rather than something request code could forget to avoid.
#
# The values below are the UNSPLIT starting point: both DSNs name the superuser, so a
# bare checkout connects and runs. That configuration is not secure and does not pretend
# to be — the backend logs an ERROR at boot ("row-level security is inert; every tenant
# policy is bypassed"), `scripts/preflight.sh` shows the RLS row DOWN, and a non-dev
# APP_ENV refuses to start at all. Running scripts/db-roles.sh rewrites both lines:
#   POSTGRES_DSN=postgresql://aegis_app:<generated>@localhost:5432/taif
POSTGRES_DSN=postgresql://postgres:postgres@localhost:5432/taif
POSTGRES_ADMIN_DSN=postgresql://postgres:postgres@localhost:5432/taif
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace-me
REDIS_URL=redis://localhost:6379/0
# Vector store (ANN for retrieval + memory recall). It is EMBEDDED — it runs inside the
# backend process against this directory, so there is no server to install and no port
# to open. Relative paths resolve against the backend's working directory. In full
# stores mode the directory must be writable: the backend fails loud at boot if it is
# not, rather than degrading to a non-durable in-RAM index.
VECTOR_STORE_PATH=vector_storage

# ── Durable job substrate (Temporal) ─────────────────────────────────────────
# Temporal orchestrates execution — retries, timers, resumability, cancellation — while
# our own `job_runs` / `documents` tables stay the system of record. It is one more
# process on the box (~135 MB, 0.2 s to start): `temporal server start-dev`.
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
# Which task queues this process's worker polls, comma-separated. Empty means every
# declared queue, which is the single-box demo posture; a scale-out deployment runs one
# process per queue, because `max_concurrent_activities` is a per-WORKER setting and the
# whole point of `aegis-cpu` is that its worker has exactly one activity slot (a Docling
# parse peaks around 2.2 GB; two at once take a 16 GB machine down). A name that is not
# one of aegis-cpu / aegis-io / aegis-default makes the worker refuse to start, because
# polling a queue nothing schedules onto fails silently — work just stops happening.
TEMPORAL_TASK_QUEUES=
# Run the worker in-process, as an asyncio task in the API's lifespan. True is the demo
# posture (one process, nothing extra to start); set false when running the identical
# code path standalone as `python -m app.jobs.worker`.
TEMPORAL_WORKER_INPROCESS=true

# ── Ingestion (Docling) ──────────────────────────────────────────────────────
# Load the layout and table models when the worker starts, not when the first document
# arrives. True on the box that runs the ingest worker; false everywhere else, because
# the models hold a little under a gigabyte resident and a process that never runs the
# parse stage should not carry them. Measured on an M3 with the cache primed the saving
# is ~3 s — the cost worth avoiding is the 730 MB first download, so prefetch the models
# on the demo machine while there is still network:
#   python spikes/docling_spike.py --prefetch ~/.cache/docling/models
DOCLING_WARM_ON_START=false

# ── Web search (Tavily, for the research sub-agent) ──────────────────────────
# NOTE THE SPELLING. This file previously had no entry at all and `backend/.env`
# carried `TRAVILY_API_KEY` — a name nothing in the codebase ever read, which is the
# entire reason web search never worked. It is `TAVILY_API_KEY`, and only that name is
# read (`aegis.websearch.tavily.API_KEY_ENV`).
#
# Leaving it unset is a supported posture, not a broken one: the research path degrades
# to the internal corpus, logs at ERROR and emits a `web_search` event carrying
# `status=degraded_no_key`. What it must never do is return an empty result set that
# reads like a clean search that found nothing.
TAVILY_API_KEY=replace-me

# ── Observability (Arize Phoenix, local in-process) ──────────────────────────
PHOENIX_ENABLED=true

# ── App ──────────────────────────────────────────────────────────────────────
APP_ENV=dev
LOG_LEVEL=INFO

# ── Durable paths and offline operation ──────────────────────────────────────
# Where uploaded document bytes and their parse artifacts live. Defaults to
# `document_storage` resolved against the backend's working directory, which is
# inside the repo — a `git clean -fd` there destroys every uploaded document while
# its row in Postgres survives, and the upload's content_sha256 dedup then refuses
# to re-ingest it. Point this somewhere outside the working tree.
DOCUMENT_STORE_PATH=

# Where the local cross-encoder's ONNX weights are cached. Unset, fastembed uses
# $TMPDIR, which macOS purges and a reboot clears — measured at 490 MB. A venue
# with no network and an empty cache gets
# `ValueError: Could not load model jinaai/jina-reranker-v1-tiny-en from any source`
# at query time, which is the worst moment to find out. Point it somewhere durable.
FASTEMBED_CACHE_PATH=

# Docling contacts huggingface.co on every worker start even with the 1.8 GB
# ~/.cache/docling present. Verified working from cache with this set, and a
# captive-portal wifi — not an absent one — is the case that hangs.
HF_HUB_OFFLINE=1

# ── The database console (§7.9) ──────────────────────────────────────────────
# The one surface that reads the data layer directly, so it is OFF unless a
# deployment deliberately turns it on. Both variables are required: the switch
# alone does nothing, because a console without a connection of its own would
# otherwise fall back to POSTGRES_DSN — the serving role, which can write.
#
# Provision the connection it uses (as the OWNER of the tables, and again after
# every schema change, so new tables become readable):
#   python -m aegis.dbadmin --role aegis_readonly --password '<strong>' > readonly.sql
#   psql -U postgres -d taif -f readonly.sql
#
# That role is NOSUPERUSER NOBYPASSRLS, owns nothing, holds SELECT and nothing
# else, and has users.password_hash withheld by a column grant. The backend
# re-reads those privileges over the same connection before every request and
# refuses to serve one that can write, so pointing this at the wrong role is a
# refusal on the first request rather than a hole.
AEGIS_DB_CONSOLE_ENABLED=false
AEGIS_DB_CONSOLE_DSN=
# Planner cost above which a read is refused before it runs, so an expensive
# query returns an explanation instead of a ten-second timeout.
AEGIS_DB_CONSOLE_MAX_PLAN_COST=5000000
