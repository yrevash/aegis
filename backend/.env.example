# ── Model gateway (LiteLLM → custom OpenAI-compatible provider) ──────────────
GENAILAB_BASE_URL=https://genailab.tcs.in
GENAILAB_API_KEY=replace-me
# Gateway uses a self-signed cert; disable TLS verification for it only.
GENAILAB_SSL_VERIFY=false

# ── Local stores (no Docker; local installs) ─────────────────────────────────
# TWO Postgres DSNs, and the difference between them is a security boundary.
#
# POSTGRES_DSN is the SERVING connection: every request runs on it. It must name a role
# with neither SUPERUSER nor BYPASSRLS, because Postgres skips row security entirely for
# a role that has either — which makes all 13 tenant_isolation policies inert. Run
# `scripts/db-roles.sh` (or `scripts\db-roles.ps1`) once: it creates `aegis_app` with
# only the DML grants it needs and rewrites these two lines for you.
#
# POSTGRES_ADMIN_DSN is the OWNER/DDL connection: create_all, the additive schema
# reconciler and the RLS bootstrap run there, and nothing else does. Those steps
# legitimately bypass RLS; keeping them on their own connection is what makes bypass a
# property of the connection rather than something request code could forget to avoid.
#
# The values below are the UNSPLIT starting point: both DSNs name the superuser, so a
# bare checkout connects and runs. That configuration is not secure and does not pretend
# to be — the backend logs an ERROR at boot ("row-level security is inert; every tenant
# policy is bypassed"), `scripts/preflight.sh` shows the RLS row DOWN, and a non-dev
# APP_ENV refuses to start at all. Running scripts/db-roles.sh rewrites both lines:
#   POSTGRES_DSN=postgresql://aegis_app:<generated>@localhost:5432/taif
POSTGRES_DSN=postgresql://postgres:postgres@localhost:5432/taif
POSTGRES_ADMIN_DSN=postgresql://postgres:postgres@localhost:5432/taif
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace-me
REDIS_URL=redis://localhost:6379/0
# Vector store (ANN for retrieval + memory recall). It is EMBEDDED — it runs inside the
# backend process against this directory, so there is no server to install and no port
# to open. Relative paths resolve against the backend's working directory. In full
# stores mode the directory must be writable: the backend fails loud at boot if it is
# not, rather than degrading to a non-durable in-RAM index.
VECTOR_STORE_PATH=vector_storage

# ── Durable job substrate (Temporal) ─────────────────────────────────────────
# Temporal orchestrates execution — retries, timers, resumability, cancellation — while
# our own `job_runs` / `documents` tables stay the system of record. It is one more
# process on the box (~135 MB, 0.2 s to start): `temporal server start-dev`.
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
# Which task queues this process's worker polls, comma-separated. Empty means every
# declared queue, which is the single-box demo posture; a scale-out deployment runs one
# process per queue, because `max_concurrent_activities` is a per-WORKER setting and the
# whole point of `aegis-cpu` is that its worker has exactly one activity slot (a Docling
# parse peaks around 2.2 GB; two at once take a 16 GB machine down). A name that is not
# one of aegis-cpu / aegis-io / aegis-default makes the worker refuse to start, because
# polling a queue nothing schedules onto fails silently — work just stops happening.
TEMPORAL_TASK_QUEUES=
# Run the worker in-process, as an asyncio task in the API's lifespan. True is the demo
# posture (one process, nothing extra to start); set false when running the identical
# code path standalone as `python -m app.jobs.worker`.
TEMPORAL_WORKER_INPROCESS=true

# ── Observability (Arize Phoenix, local in-process) ──────────────────────────
PHOENIX_ENABLED=true

# ── App ──────────────────────────────────────────────────────────────────────
APP_ENV=dev
LOG_LEVEL=INFO
